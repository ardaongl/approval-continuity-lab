include README.md PACKAGE-README.md DISCOVERY.md AGENTS.md GOAL.md LICENSE
include .python-version requirements-build.txt requirements-build.lock
recursive-include docs *.md *.json *.txt
recursive-include scripts *.py
recursive-include tests *.py *.json
recursive-include .github *.yml
recursive-include src/approval_continuity_lab/documentation *.md *.json *.txt
global-exclude *.pyc *.pyo .DS_Store
prune .local-verification
prune .venv
prune dist
prune build
